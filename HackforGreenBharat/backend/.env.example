# EcoSense Backend Environment Configuration Example
# Copy this file to .env and configure keys appropriately.
# NEVER commit .env files containing real secrets.

PORT=5000
MONGO_URI=mongodb://localhost:27017/ecosense
JWT_SECRET=your_jwt_secret_key_here

# Open Government Data (data.gov.in) & CPCB Ingestion API Keys
# Register and get an API key from https://data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
CPCB_API_KEY=your_cpcb_api_key_here

# Scheduled Ingestion Interval (Hours)
AQI_INGEST_INTERVAL_HOURS=6

# Cloudinary (Optional, for media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Providers
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key
